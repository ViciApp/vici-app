# VICI SPA image for Fly.io: builds the static SvelteKit output and serves it
# with nginx + SPA fallback. Vite inlines VITE_* vars at build time, so they
# are build ARGs, not runtime secrets. Deployed by the manual workflow
# .github/workflows/web2-deploy.yml, which bakes the args from fly.web.toml.
FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# The API origin the SPA calls and the backend mode switch. Empty defaults
# keep a bare `docker build` on the web3 stack; fly.web.toml sets the web2 values.
ARG VITE_WEB2_API_URL=""
ARG VITE_BACKEND=""
ENV VITE_WEB2_API_URL=$VITE_WEB2_API_URL
ENV VITE_BACKEND=$VITE_BACKEND
RUN npm run build

FROM nginx:alpine
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 8080
