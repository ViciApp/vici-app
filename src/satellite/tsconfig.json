{
	"compilerOptions": {
		"moduleDetection": "force",
		"module": "ES2020",
		"target": "ES2020",
		"lib": ["ES2020", "dom"],
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"rootDir": "../..",
		"outDir": "../../target/deploy",
		"paths": {
			"#lib/*": ["../lib/*"],
			"$satellite": ["."],
			"$satellite/*": ["./*"],
			"$root/*": ["../../*"],
			"$declarations": ["../declarations"],
			"$declarations/*": ["../declarations/*"]
		}
	},
	"include": ["**/*.ts"]
}
