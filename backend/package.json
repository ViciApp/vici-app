{
	"name": "vici-app-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "VICI app backend API (Bun + Elysia + Postgres).",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"worker": "bun run src/worker.ts",
		"migrate": "bun run src/db/migrate.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"e2e:seed": "bun run e2e/seed.ts",
		"e2e:server": "bun run e2e/server.ts",
		"e2e:stack": "bun run e2e/preflight.ts && bun run migrate && bun run e2e:seed && bun run e2e:server"
	},
	"dependencies": {
		"@dfinity/utils": "^5.0.0",
		"@elysiajs/cors": "^1.4.3",
		"@icp-sdk/canisters": "^4.0.0",
		"@icp-sdk/core": "^6.1.1",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@scure/base": "^2.4.0",
		"@scure/btc-signer": "^2.4.1",
		"elysia": "^1.4.32",
		"pg": "^8.23.1",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"@types/pg": "^8.23.1",
		"typescript": "^6.0.0"
	}
}
