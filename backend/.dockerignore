# The end-to-end server, fake engine and seed (e2e/) are test-only entrypoints
# for the Playwright suite; keeping them out of the image means a deployed
# machine has no copy of them to run. See e2e/guard.ts.
e2e/

# The local-disk upload fallback (dev and test runs); production stores league
# images in Tigris, so an image needs no copy of whatever a dev run left here.
uploads/

# Installed by the Dockerfile for Linux with --production; a host copy (other
# platform natives, devDependencies) would overwrite it at `COPY . .`.
node_modules/

# Local secrets: production reads its env from Fly secrets, never a file.
.env*

# The test suite runs from a checkout (see README.md), never on a deployed
# machine.
tests/

# Files a checkout that ran the retired legacy import or account handover may
# still hold: collection snapshots, email sheets and reports, all user data.
etl-export*/
*.csv
cutover-*.jsonl
