{
	"name": "vici-app",
	"version": "1.8.40",
	"juno": {
		"functions": {
			"version": "1.8.40"
		}
	},
	"private": true,
	"scripts": {
		"dev": "vite dev --force",
		"build": "tsc --noEmit && vite build",
		"seo:assets": "tsx scripts/build/generate-seo-assets.ts",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:i18n": "node scripts/check-locale-catalogs.mjs",
		"lint": "prettier --cache ${CI:+--cache-strategy content} --check . && eslint . --cache ${CI:+--cache-strategy content} --max-warnings 0 && npm run check:i18n",
		"format": "prettier --cache ${CI:+--cache-strategy content} --write . && eslint . --cache ${CI:+--cache-strategy content} --fix",
		"quality": "npm run format && npm run lint",
		"did": "./scripts/did.sh && npm run format && npm run lint",
		"deploy": "./scripts/deploy.sh",
		"init:clearing": "./scripts/init/init.clearing.sh",
		"init:icdc-engine": "./scripts/init/init.icdc-engine.sh",
		"init:icdc-dev-bootstrap": "./scripts/init/init.icdc-dev-bootstrap.sh",
		"init:registry": "./scripts/init/init.registry.sh",
		"deploy:markets": "./scripts/deploy-markets.sh",
		"tag:markets": "./scripts/tag-markets.sh",
		"translate:markets": "./scripts/translate-markets.sh",
		"init:icdc": "npm run init:clearing && npm run init:icdc-engine && npm run init:registry && npm run init:icdc-dev-bootstrap",
		"test:engine-sync": "./scripts/test/test-engine-sync.sh",
		"init:vxp-treasury": "./scripts/init/init.vxp-treasury.sh",
		"juno:functions:build": "juno functions build --lang ts",
		"juno:functions:upgrade:dev": "juno functions upgrade -m development",
		"restart:icdc": "./scripts/restart.icdc.sh",
		"restart:vxp": "./scripts/restart.vxp.sh",
		"postinstall:copy-auth": "node -e \"require('fs').cpSync('node_modules/@junobuild/core/dist/workers/', './static/workers', {recursive: true});\"",
		"postinstall": "npm run postinstall:copy-auth",
		"playwright:install": "playwright install --with-deps",
		"e2e": "npm run playwright:install && playwright test",
		"e2e:ci": "playwright test --update-snapshots=changed --reporter=html,list",
		"e2e:report": "playwright show-report"
	},
	"devDependencies": {
		"@dfinity/eslint-config-oisy-wallet": "^0.5.0",
		"@icp-sdk/bindgen": "^0.4.0",
		"@junobuild/config": "^3.0.1",
		"@junobuild/vite-plugin": "^4.7.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"playwright": "^1.59.1",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.12",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1"
	},
	"type": "module",
	"dependencies": {
		"@dfinity/utils": "^4.2.1",
		"@icp-sdk/canisters": "^3.5.2",
		"@icp-sdk/core": "^5.4.0",
		"@icp-sdk/signer": "^5.6.2",
		"@junobuild/core": "^5.4.0",
		"@junobuild/functions": "^0.9.0",
		"@junobuild/schema": "^1.2.4",
		"@lucide/svelte": "^1.31.0",
		"decimal.js": "^10.6.0",
		"ethers": "^6.16.0",
		"icp-auth-openid": "npm:@icp-sdk/auth@^6.2.2",
		"nanoid": "^6.0.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"ws": "^8.21.3"
	}
}
