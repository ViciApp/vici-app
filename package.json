{
	"name": "vici-app",
	"version": "1.8.66",
	"private": true,
	"packageManager": "npm@11.21.1",
	"scripts": {
		"dev": "vite dev --force",
		"build": "tsc --noEmit && vite build",
		"seo:assets": "tsx scripts/build/generate-seo-assets.ts",
		"seo:web2-head": "tsx scripts/build/generate-shell-head.ts",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.tools.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:i18n": "node scripts/check-locale-catalogs.mjs",
		"check:dashes": "node scripts/check-dashes.mjs",
		"lint": "prettier --cache ${CI:+--cache-strategy content} --check . && eslint . --cache ${CI:+--cache-strategy content} --max-warnings 0 && npm run check:i18n && npm run check:dashes",
		"format": "prettier --cache ${CI:+--cache-strategy content} --write . && eslint . --cache ${CI:+--cache-strategy content} --fix",
		"quality": "npm run format && npm run lint",
		"did": "./scripts/did.sh && npm run format && npm run lint",
		"deploy": "./scripts/deploy.sh",
		"init:clearing": "./scripts/init/init.clearing.sh",
		"init:icdc-engine": "./scripts/init/init.icdc-engine.sh",
		"init:icdc-dev-bootstrap": "./scripts/init/init.icdc-dev-bootstrap.sh",
		"init:registry": "./scripts/init/init.registry.sh",
		"deploy:markets": "./scripts/deploy-markets.sh",
		"init:icdc": "npm run init:clearing && npm run init:icdc-engine && npm run init:registry && npm run init:icdc-dev-bootstrap",
		"test": "tsx --test \"src/tests/**/*.spec.ts\"",
		"restart:icdc": "./scripts/restart.icdc.sh",
		"restart:vxp": "./scripts/restart.vxp.sh",
		"playwright:install": "playwright install --with-deps",
		"e2e:web2": "playwright install chromium && npm run e2e:web2:ci",
		"e2e:web2:ci": "playwright test --config playwright.config.ts",
		"e2e:web2:report": "playwright show-report playwright-report-web2"
	},
	"devDependencies": {
		"@dfinity/eslint-config-oisy-wallet": "^0.5.1",
		"@icp-sdk/bindgen": "^0.4.1",
		"@junobuild/config": "^3.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.65.1",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"type": "module",
	"dependencies": {
		"@dfinity/utils": "^4.2.1",
		"@dfinity/zod-schemas": "^3.2.0",
		"@icp-sdk/canisters": "^3.5.2",
		"@icp-sdk/core": "^5.4.0",
		"@lucide/svelte": "^1.77.0",
		"decimal.js": "^10.6.0",
		"ethers": "^6.17.0",
		"nanoid": "^6.0.2",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@dfinity/eslint-config-oisy-wallet": {
			"typescript": "$typescript"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		}
	},
	"imports": {
		"#declarations": "./src/declarations/index.ts",
		"#declarations/*": "./src/declarations/*",
		"#lib/*": "./src/lib/*",
		"#root/*": "./*"
	}
}
